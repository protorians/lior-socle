# Encryption
NEXT_PUBLIC_ENCRYPTION_KEY=sentient.socle.encrypted/sample

# Sentient Dashboard
NEXT_PUBLIC_APP_SLUG=app.sentient.socle
NEXT_PUBLIC_APP_NAME="Sentient"
NEXT_PUBLIC_APP_VERSION=0.0.1
NEXT_PUBLIC_APP_VERSION_NUMBER=1
NEXT_PUBLIC_APP_HOST=https://localhost:5010
NEXT_PUBLIC_UI_REFRESH_TIMEOUT=30000
NEXT_PUBLIC_APP_REFRESH_UI=30000
NEXT_PUBLIC_AUTH_CHECK_SESSION_TIMEOUT=60000
NEXT_PUBLIC_UI_ACTIVITY_TRACKER_TIMEOUT=300000

# Sentient API
NEXT_PUBLIC_CORE_SOCKET_HOST=wss://localhost:5010
NEXT_PUBLIC_CORE_API_HOST=https://localhost:5711/api
NEXT_PUBLIC_API_TIMEOUT=30000

# Web Push (VAPID) - générer via: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sentient Auth (SSO) — hôte d'authentification
NEXT_PUBLIC_AUTH_HOST=https://localhost:5050
