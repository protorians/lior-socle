{
  "schemaVersion": 1,
  "id": "identity",
  "domain": "mod.liorian.identity",
  "key": "IDENTITY",
  "name": "Utilisateurs",
  "description": "Gestion des comptes et activités",
  "version": "1.0.0",
  "icon": "UsersIcon",
  "type": "INTERNAL",
  "entry": "index.tsx",
  "uri": "/identity",
  "publisher": {
    "id": "liorian",
    "name": "Liorian Workspace"
  },
  "platforms": {
    "web": {
      "supported": true,
      "modes": ["web"]
    },
    "desktop": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["windows", "macos", "linux"]
    },
    "mobile": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["android"],
      "iosSupported": false
    }
  },
  "managerCompatibility": {
    "min": "0.17.1",
    "max": "0.17.x"
  },
  "apiCompatibility": {
    "min": "0.27.0",
    "max": "0.27.x"
  },
  "permissions": ["identity.read", "identity.write", "identity.manage"],
  "apiScopes": ["identity.read", "identity.write"],
  "capabilities": {
    "needsNetwork": true,
    "supportsOffline": false,
    "requiresOrganization": true,
    "requiresAuthenticatedUser": true
  },
  "isEnabled": true,
  "isDefault": false,
  "requirements": {
    "organization": ">=1.0.0",
    "access-control": ">=1.0.0"
  },
  "optionalRequirements": {},
  "dependencies": {
    "@liorian/sdk": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "widgets": ["analytics"],
  "routines": ["usersAnalyticsRoutine"]
}