{
  "schemaVersion": 1,
  "id": "modules-management",
  "domain": "mod.liorian.store",
  "key": "STORE",
  "name": "Store",
  "description": "Store : découvrez, installez et gérez les applications de votre espace",
  "version": "1.0.0",
  "icon": "StoreIcon",
  "type": "INTERNAL",
  "entry": "index.tsx",
  "uri": "/store",
  "publisher": {
    "id": "liorian",
    "name": "Liorian Workspace"
  },
  "platforms": {
    "web": {
      "supported": true,
      "modes": ["web"]
    },
    "desktop": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["windows", "macos", "linux"]
    },
    "mobile": {
      "supported": true,
      "modes": ["local-webview"],
      "os": ["android"],
      "iosSupported": false
    }
  },
  "managerCompatibility": {
    "min": "0.17.1",
    "max": "0.17.x"
  },
  "apiCompatibility": {
    "min": "0.27.0",
    "max": "0.27.x"
  },
  "permissions": ["modules_management.read", "modules_management.write", "modules_management.manage"],
  "apiScopes": ["modules_management.read", "modules_management.write"],
  "capabilities": {
    "needsNetwork": true,
    "supportsOffline": false,
    "requiresOrganization": true,
    "requiresAuthenticatedUser": true
  },
  "isEnabled": true,
  "isDefault": false,
  "requirements": {},
  "optionalRequirements": {},
  "dependencies": {
    "@liorian/sdk": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^1.21.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  },
  "widgets": ["analytics"],
  "routines": ["storeSyncRoutine"],
  "menu": {
    "items": [
      {
        "label": "Explorer",
        "icon": "CompassIcon",
        "url": "/store/explorer"
      },
      {
        "label": "Mes modules",
        "icon": "AppWindowIcon",
        "url": "/store/installed"
      },
      {
        "label": "Paramètres",
        "icon": "SettingsIcon",
        "url": "/store/settings"
      }
    ]
  }
}