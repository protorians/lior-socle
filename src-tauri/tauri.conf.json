{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liorian Manager",
  "version": "0.13.0",
  "identifier": "com.protorians.liorian.manager",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5010",
    "beforeBuildCommand": "bun run build:tauri",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Liorian Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "userAgent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10.15; rv:153.0) Liorian/0.0.1 Protorians/0.0.1 Gecko/20100101 Firefox/153.0",
        "fullscreen": true
      }
    ],
    "security": {
      "capabilities": [
        "main-capability"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'unsafe-inline' 'self'",
        "img-src": "'self' asset: http://asset.localhost blob: data: http://localhost:5711 http://192.168.1.92:5711",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:5711 ws://localhost:5711 http://192.168.1.92:5711 ws://192.168.1.92:5711",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
