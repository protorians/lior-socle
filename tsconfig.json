{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/external_modules": ["./external_modules/index.tsx"],
      "@/external_modules/*": ["./external_modules/*"],
      "@liorian/sdk": ["../../packages/sdk/src/index.ts"],
      "@liorian/sdk/*": ["../../packages/sdk/src/*"],
      "@liorian/module-accounting": ["./external_modules/accounting/index.tsx"],
      "@liorian/module-accounting/*": ["./external_modules/accounting/*"],
      "@liorian/module-billing": ["./external_modules/billing/index.tsx"],
      "@liorian/module-billing/*": ["./external_modules/billing/*"],
      "@liorian/module-blogging": ["./external_modules/blogging/index.tsx"],
      "@liorian/module-blogging/*": ["./external_modules/blogging/*"],
      "@liorian/module-calendar": ["./external_modules/calendar/index.tsx"],
      "@liorian/module-calendar/*": ["./external_modules/calendar/*"],
      "@liorian/module-crm": ["./external_modules/crm/index.tsx"],
      "@liorian/module-crm/*": ["./external_modules/crm/*"],
      "@liorian/module-customer": ["./external_modules/customer/index.tsx"],
      "@liorian/module-customer/*": ["./external_modules/customer/*"],
      "@liorian/module-ecommerce": ["./external_modules/ecommerce/index.tsx"],
      "@liorian/module-ecommerce/*": ["./external_modules/ecommerce/*"],
      "@liorian/module-messenger": ["./external_modules/messenger/index.tsx"],
      "@liorian/module-messenger/*": ["./external_modules/messenger/*"],
      "@liorian/module-pos-management": ["./external_modules/pos-management/index.tsx"],
      "@liorian/module-pos-management/*": ["./external_modules/pos-management/*"],
      "@liorian/module-project-management": ["./external_modules/project-management/index.tsx"],
      "@liorian/module-project-management/*": ["./external_modules/project-management/*"],
      "@liorian/module-restaurant": ["./external_modules/restaurant/index.tsx"],
      "@liorian/module-restaurant/*": ["./external_modules/restaurant/*"],
      "@liorian/module-stock-management": ["./external_modules/stock-management/index.tsx"],
      "@liorian/module-stock-management/*": ["./external_modules/stock-management/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.*"
  ]
}
