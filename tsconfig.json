{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/library/modules": ["./library/modules/index.tsx"],
      "@/library/modules/*": ["./library/modules/*"],
      "@liorian/sdk": ["../../packages/sdk/src/index.ts"],
      "@liorian/sdk/*": ["../../packages/sdk/src/*"],
      "@liorian/module-accounting": ["./library/modules/accounting/index.tsx"],
      "@liorian/module-accounting/*": ["./library/modules/accounting/*"],
      "@liorian/module-billing": ["./library/modules/billing/index.tsx"],
      "@liorian/module-billing/*": ["./library/modules/billing/*"],
      "@liorian/module-blogging": ["./library/modules/blogging/index.tsx"],
      "@liorian/module-blogging/*": ["./library/modules/blogging/*"],
      "@liorian/module-calendar": ["./library/modules/calendar/index.tsx"],
      "@liorian/module-calendar/*": ["./library/modules/calendar/*"],
      "@liorian/module-crm": ["./library/modules/crm/index.tsx"],
      "@liorian/module-crm/*": ["./library/modules/crm/*"],
      "@liorian/module-customer": ["./library/modules/customer/index.tsx"],
      "@liorian/module-customer/*": ["./library/modules/customer/*"],
      "@liorian/module-ecommerce": ["./library/modules/ecommerce/index.tsx"],
      "@liorian/module-ecommerce/*": ["./library/modules/ecommerce/*"],
      "@liorian/module-messenger": ["./library/modules/messenger/index.tsx"],
      "@liorian/module-messenger/*": ["./library/modules/messenger/*"],
      "@liorian/module-pos-management": ["./library/modules/pos-management/index.tsx"],
      "@liorian/module-pos-management/*": ["./library/modules/pos-management/*"],
      "@liorian/module-project-management": ["./library/modules/project-management/index.tsx"],
      "@liorian/module-project-management/*": ["./library/modules/project-management/*"],
      "@liorian/module-restaurant": ["./library/modules/restaurant/index.tsx"],
      "@liorian/module-restaurant/*": ["./library/modules/restaurant/*"],
      "@liorian/module-stock-management": ["./library/modules/stock-management/index.tsx"],
      "@liorian/module-stock-management/*": ["./library/modules/stock-management/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/*.test.*"
  ]
}
